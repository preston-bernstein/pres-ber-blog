; https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 2
indent_style = space
trim_trailing_whitespace = true
insert_final_newline = true

[*.md]
trim_trailing_whitespace = false

[*.{sh,bash}]
indent_style = space
indent_size = 2
shell_variant = bash
binary_next_line = true
switch_case_indent = true
end_of_line = lf
insert_final_newline = true

[*.bats]
indent_style = space
indent_size = 2
shell_variant = bats
binary_next_line = true
switch_case_indent = true
end_of_line = lf
insert_final_newline = true
